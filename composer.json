{
    "name": "muno92/asn1-tools",
    "description": "ASN.1 reader and writer (BER/DER) for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "asn1",
        "ber",
        "der",
        "x509",
        "pem"
    ],
    "authors": [
        {
            "name": "muno92"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "symplify/easy-coding-standard": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Asn1Tools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asn1Tools\\Tests\\": "tests/"
        }
    }
}
